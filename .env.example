# --- Neon -------------------------------------------------------------------
# POOLED string (host contains `-pooler`) — used by the app at runtime.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT string (no `-pooler`) — used by drizzle-kit for migrations only.
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Auth -------------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth (primary sign-in) -----------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (optional magic-link fallback) -----------------------------------
# Optional: only needed if someone has no Google account.
# RESEND_API_KEY=""
# EMAIL_FROM="recipes@teelingrecipes.com"

# --- Images -----------------------------------------------------------------
# Auto-injected by Vercel when you create a Blob store; set manually for local.
BLOB_READ_WRITE_TOKEN=""
