# --- Neon database ----------------------------------------------------------
# POOLED string (host contains `-pooler`) — used by the app at runtime.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT string (no `-pooler`) — used by drizzle-kit for migrations only.
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Neon Managed Better Auth -----------------------------------------------
# From Neon Console -> Auth. Google OAuth credentials are configured THERE,
# not here, so no client id or secret lives in this app.
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.us-east-1.aws.neon.tech"

# Signs the session cookie. Minimum 32 characters.
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# Verifies Neon's user.before_create webhook, which is the allowlist gate.
# Without it, anyone who finds the webhook URL could approve their own signup.
#   openssl rand -base64 32
NEON_AUTH_WEBHOOK_SECRET=""

# --- Images -----------------------------------------------------------------
# Auto-injected by Vercel when you create a Blob store; set manually for local.
BLOB_READ_WRITE_TOKEN=""
